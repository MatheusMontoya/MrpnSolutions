# A CLI da Vercel NÃO usa o .gitignore — sem este arquivo o banco de
# desenvolvimento sobe no pacote e o app lê dados velhos de um SQLite
# read-only em vez de falhar claro apontando para a DATABASE_URL.
*.db
*.db-journal
.env
.env.*

# não fazem parte do runtime
docs/
backend/tests/
backend/.venv/
backend/requirements-dev.txt
# migração roda como passo de deploy, de uma estação — nunca em cold start.
# O alembic nem está no requirements.txt de runtime.
backend/migrations/
backend/alembic.ini
backend/migrar.py
backend/gerar_linha_de_base.py
backend/conferir_migracoes.py
backend/ferramentas_migracao.py
backend/dev_vazio.py
backend/configurar_conexao.py
node_modules/
.pytest_cache/
__pycache__/

# senha crua temporaria (configurar_conexao.py apaga depois de usar)
senha.txt
conexao.txt
