# Conexão do Supabase — use a string do POOLER (Connection Pooling, porta 6543),
# não a conexão direta na 5432: em serverless a direta esgota as conexões.
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: chave da Anthropic para o copiloto. Sem ela o copiloto continua
# funcionando, só com os insights determinísticos do motor.
# ANTHROPIC_API_KEY=
